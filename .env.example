# KR, JP, US, GB, DE 중 하나. config.js의 COUNTRIES에 정의된 나라 코드만 사용 가능.
COUNTRY=KR

# 클라우드 배포 시에만 필요. 설정하면 launchd/claude CLI 없이 서버가 직접
# Gemini API로 1시간마다 트렌드 수집·요약을 수행한다. 로컬에서 launchd + claude CLI를
# 쓰는 경우엔 비워두면 된다. https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=

# 선택. 요약에 사용할 모델. 기본값은 gemini-3.6-flash (비용 효율적).
GEMINI_MODEL=
